{
  "name": "music-discographies",
  "type": "module",
  "version": "0.1.0",
  "description": "Structured discography data for multiple artists, with a static browser.",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev --host localhost --port 4210",
    "build": "astro build",
    "preview": "astro preview --port 4210",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "node scripts/validate-data.mjs",
    "db:export": "node scripts/to-sqlite.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "^8.67.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "src/content/**/*.json": [
      "prettier --write",
      "node scripts/validate-data.mjs"
    ],
    "*.{js,jsx,astro,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^20.3.0 || >=22.0.0"
  }
}
