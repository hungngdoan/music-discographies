{
  "name": "music-discographies",
  "type": "module",
  "version": "0.1.0",
  "description": "Structured discography data for multiple artists, with a static browser.",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev --host localhost --port 4210",
    "build": "astro build",
    "preview": "astro preview --port 4210",
    "validate": "node scripts/validate-data.mjs",
    "db:export": "node scripts/to-sqlite.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "src/content/**/*.json": [
      "prettier --write",
      "node scripts/validate-data.mjs"
    ],
    "*.{js,jsx,astro,css,json,md,mjs,yml}": [
      "prettier --write"
    ]
  }
}
